# 信息差发现平台 — 爬虫系统 环境变量模板
# 复制为 .env 后填写真实值

# 后端 API 地址（必填）
BACKEND_URL=http://localhost:8080/api/crawler

# DeepSeek API Key，用于 AI 评估（可选）
DEEPSEEK_API_KEY=sk-xxx

# Redis 地址，用于分布式去重（可选，不设置则使用内存去重）
REDIS_URL=redis://localhost:6379/0

# 代理地址，海外爬取时使用（可选）
PROXY_URL=http://proxy:8080

# 日志级别（DEBUG / INFO / WARNING / ERROR）
LOG_LEVEL=INFO
